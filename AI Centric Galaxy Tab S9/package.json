{
  "name": "galaxy-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14"
  },
  "scripts": {
    "dev": "node --watch server/main.ts",
    "start": "node server/main.ts",
